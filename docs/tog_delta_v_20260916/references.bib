@inproceedings{Kim2020,
  author    = {Kim, Dong-Hee and Lee, Changwoo and Chung, Ki-Seok},
  title     = {A Confidence-Calibrated {MOBA} Game Winner Predictor},
  booktitle = {2020 {IEEE} Conference on Games ({CoG})},
  year      = {2020},
  pages     = {622--625},
  doi       = {10.1109/CoG47356.2020.9231878},
  url       = {https://ieee-cog.org/2020/papers/paper_221.pdf},
  note      = {Verified against the conference PDF; page and DOI metadata from the Hanyang institutional record
               https://scholarworks.bwise.kr/hanyang/handle/2021.sw.hanyang/3695},
  annote    = {SUPPORTS: motivation to assess probability calibration and input-dependent uncertainty for
               League of Legends win prediction, which matters here because the Delta V label is built from
               probabilities. DOES NOT SUPPORT: any claim that this project implements their neural
               density/MLP architecture, their data-uncertainty-aware loss or their Monte Carlo softmax
               calibration; our V is a raw logistic model. Their reported calibration numbers, features,
               population and accuracies are not Delta V results.}
}

@article{Maymin2021,
  author  = {Maymin, Philip Z.},
  title   = {Smart kills and worthless deaths: {eSports} analytics for {League of Legends}},
  journal = {Journal of Quantitative Analysis in Sports},
  year    = {2021},
  volume  = {17},
  number  = {1},
  pages   = {11--27},
  doi     = {10.1515/jqas-2019-0096},
  url     = {https://d-nb.info/1367424143/34},
  note    = {Published online 2020-09-21, assigned to the 2021 volume/issue; cite the 2021 journal record.
             Verified against the full text and the author publication page https://philipmaymin.com/academic-papers},
  annote  = {SUPPORTS: the lineage of a simple time/state logistic in-game win-probability model for League of
             Legends, and of evaluating events by the change in a frozen estimated win probability. The paper
             fits on elapsed minutes and both teams' cumulative kills, towers and large monsters, sampling one
             random minute per game for that step. DOES NOT SUPPORT: our feature schema, patch/cohort
             population, engagement definition, endpoint rule, V, q, calibration results, or any causal reading.
             Delta V remains a model-derived probability difference over our own window, not a counterfactual.}
}

