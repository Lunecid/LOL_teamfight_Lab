  title     = {User Session Identification Based on Strong Regularities in Inter-activity Time},
  booktitle = {Proceedings of the 24th International Conference on World Wide Web ({WWW})},
  year      = {2015},
  pages     = {410--418},
  doi       = {10.1145/2736277.2741117},
  url       = {https://arxiv.org/abs/1411.2878},
  note      = {2015 WWW publication; the arXiv author copy was used for method verification but is not the
               publication record. Institutional record:
               https://experts.umn.edu/en/publications/user-session-identification-based-on-strong-regularities-in-inter/},
  annote    = {SUPPORTS: inspecting an inter-activity-time distribution and separating within- from
               between-session components to derive an activity boundary. The paper fits an EM Gaussian mixture
               on log times and takes the likelihood intersection, offering about one hour as a rule of thumb
               while showing fitted intersections range from roughly 29 to 115 minutes across logs.
               DOES NOT SUPPORT: G = 13.7 s, which is this project's pooled KDE-valley estimate on kill gaps; a
               KDE valley and a mixture intersection are different estimators on different populations. It
               justifies neither our engagement window nor any causal claim.}
}

@inproceedings{Lundberg2017,
  author    = {Lundberg, Scott M. and Lee, Su-In},
  title     = {A Unified Approach to Interpreting Model Predictions},
  booktitle = {Advances in Neural Information Processing Systems 30 ({NeurIPS} 2017)},
  year      = {2017},
  pages     = {4765--4774},
  url       = {https://proceedings.neurips.cc/paper_files/paper/2017/file/8a20a8621978632d76c43dfd28b67767-Paper.pdf},
  note      = {Verified against the official NeurIPS proceedings PDF and abstract page},
  annote    = {SUPPORTS: additive feature attribution as a unified framework, with attributions defined relative
               to an explanation mapping and summing to the represented model output under stated assumptions,
               and with feature dependence and background data affecting interpretation. DOES NOT SUPPORT:
               causal explanation. Our seven-group exact Shapley computation with fixed p_pre as one group, a
               128-row background and 256 explained rows per cell explains the fitted, calibrated q output under
               those choices; it does not explain V or Delta V and does not show that a feature caused a
               teamfight to go well.}
}

