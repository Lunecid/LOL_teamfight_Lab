{
  "python_version": "3.13.5",
  "packages": {
    "numpy": "2.1.3",
    "scipy": "1.15.3",
    "pandas": "2.2.3",
    "scikit-learn": "1.6.1",
    "torch": "2.10.0+cu128",
    "lightgbm": "4.6.0",
    "joblib": "1.4.2",
    "psutil": "5.9.0",
    "pytest": "8.3.4",
    "pyarrow": "19.0.0",
    "threadpoolctl": "3.5.0"
  },
  "native_startup": {
    "helper": "c_ept.s4a_runtime.prepare_native_runtime",
    "policy_version": 1,
    "supported_entry": "fresh-process CLI",
    "mkl_threading_layer": "SEQUENTIAL",
    "numpy_mkl_parallelism": "sequential",
    "kmp_duplicate_lib_ok": "disabled",
    "thread_environment_fields": [
      "OMP_NUM_THREADS",
      "MKL_NUM_THREADS",
      "OPENBLAS_NUM_THREADS"
    ],
    "thread_environment_values": "effective process values recorded by shared helper; not forced by Check",
    "torch_cpu_threads": {
      "expected": 8,
      "set_and_measured_by": "Task7 runner",
      "verified_by_check": false
    },
    "activation_required": false,
    "package_or_global_environment_mutation": false
  }
}
